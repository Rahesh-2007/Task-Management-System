{
  "name": "task-management-system",
  "version": "1.0.0",
  "description": "Full-Stack Task Management System built with React, Node.js, Express, and MySQL",
  "scripts": {
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test:frontend": "npm --prefix frontend test",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build"
  },
  "keywords": [
    "taskflow",
    "task-manager",
    "react",
    "nodejs",
    "mysql",
    "kanban"
  ],
  "author": "",
  "license": "MIT"
}